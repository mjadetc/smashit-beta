# Copy this file to .env (next to pom.xml) and fill in your own values.
# .env is ignored by Git, so your password never gets committed.
DB_URL=jdbc:postgresql://localhost:5432/smashit_beta
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Optional (step 8). The defaults are right for local development;
# on Render these are set as environment variables instead.
# PORT=8080
# COOKIE_SECURE=false
# SHOW_SQL=true
# CORS_ALLOWED_ORIGINS=http://localhost:5173